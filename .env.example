# Embedding: OpenAI-compatible endpoint; blank URL defaults to DashScope.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# qwen3-rerank; blank key uses OPENAI_API_KEY.
RERANK_API_KEY=

# GLM-5.2: extraction, relation proposer and graph controllers.
GLM_API_KEY=
GLM_BASE_URL=
WEAVE_MEM_GLM_ENABLE_THINKING=0

# Complete key+URL pairs for benchmark answers and judges.

BENCHMARK_ANSWER_API_KEY=
BENCHMARK_ANSWER_BASE_URL=
BENCHMARK_JUDGE_API_KEY=
BENCHMARK_JUDGE_BASE_URL=
# If judge pair is blank, the answer pair is reused. PersonaMem has no LLM judge.

# Optional generic chat route. GLM falls back here if its pair is blank.
CHAT_API_KEY=
CHAT_BASE_URL=
